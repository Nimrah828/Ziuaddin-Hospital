<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Ziauddin Hospital </title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--g:#0f6b3a;--g2:#0b5230;--m:#7a1631;--bg:#f7f8f5;--card:#fff;--ink:#1b2420;--mut:#566159;--mint:#e3f0e8;--line:#d9dfd8;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--g:#4fc183;--g2:#3aa86d;--m:#e0728f;--bg:#0f1511;--card:#17201a;--ink:#e8efe9;--mut:#a3b0a6;--mint:#1b2a20;--line:#2a372e}}
:root[data-theme="dark"]{--g:#4fc183;--g2:#3aa86d;--m:#e0728f;--bg:#0f1511;--card:#17201a;--ink:#e8efe9;--mut:#a3b0a6;--mint:#1b2a20;--line:#2a372e}
html{scroll-behavior:smooth;scroll-padding-top:70px}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 "DM Sans",system-ui,sans-serif}
h1,h2,h3{font-family:Fraunces,Georgia,serif;line-height:1.15;margin:0 0 .5em}
h1{font-size:clamp(2.2rem,5.5vw,3.8rem)}h2{font-size:clamp(1.7rem,3.5vw,2.4rem)}
a{color:inherit}
.wrap{max-width:1100px;margin:0 auto;padding:0 20px}
section{padding:64px 0}
.top{background:var(--m);color:#fff;font-size:.9rem;padding:6px 0}
.top .wrap{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
header{position:sticky;top:0;z-index:10;background:var(--card);border-bottom:1px solid var(--line)}
nav{display:flex;align-items:center;justify-content:space-between;height:62px}
.logo{font-family:Fraunces,serif;font-weight:700;font-size:1.25rem;color:var(--g);text-decoration:none}
.logo span{color:var(--m)}
.links{display:flex;gap:22px;align-items:center}
.links a{text-decoration:none;font-weight:500}.links a:hover{color:var(--g)}
.menu{display:none;background:none;border:1px solid var(--line);border-radius:8px;padding:6px 12px;color:var(--ink);font:inherit}
.btn{display:inline-block;background:var(--g);color:#fff;border:0;border-radius:8px;padding:12px 22px;font:700 1rem "DM Sans",sans-serif;text-decoration:none;cursor:pointer}
.btn:hover{background:var(--g2)}.btn.alt{background:transparent;color:var(--g);border:2px solid var(--g)}
:focus-visible{outline:3px solid var(--m);outline-offset:2px}
.hero{background:linear-gradient(135deg,var(--mint),var(--bg));padding:72px 0}
.hero .wrap{display:grid;grid-template-columns:1.3fr 1fr;gap:40px;align-items:center}
.hero p{color:var(--mut);max-width:52ch;font-size:1.1rem}
.hero .acts{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}
.er{background:var(--m);color:#fff;border-radius:16px;padding:28px}
.er h3{margin:0 0 6px}.er .num{font:700 2rem Fraunces,serif}
.er ul{list-style:none;padding:0;margin:16px 0 0;border-top:1px solid rgba(255,255,255,.3)}
.er li{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.2)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:20px}
.card h3{font-size:1.15rem;margin-bottom:.3em;color:var(--g)}.card p{margin:0;color:var(--mut);font-size:.95rem}
.tools{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px}
input,select,textarea{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--ink);font:inherit}
.tools input{max-width:300px}
.chip{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:99px;padding:8px 16px;cursor:pointer;font:inherit}
.chip.on{background:var(--g);color:#fff;border-color:var(--g)}
.doc{display:flex;gap:14px;align-items:center}
.av{flex:none;width:52px;height:52px;border-radius:50%;background:var(--mint);color:var(--g);display:grid;place-items:center;font:700 1.1rem Fraunces,serif}
.doc b{display:block}.doc small{color:var(--mut)}
.band{background:var(--mint)}
form{display:grid;grid-template-columns:1fr 1fr;gap:14px;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:24px}
form .full{grid-column:1/-1}label{font-weight:500;font-size:.9rem;display:block;margin-bottom:4px}
.err{color:var(--m);font-size:.85rem;min-height:1.2em}
.ok{display:none;background:var(--g);color:#fff;border-radius:12px;padding:20px;margin-top:16px}
.split{display:grid;grid-template-columns:1fr 1fr;gap:32px}
.map{min-height:240px;border-radius:12px;background:repeating-linear-gradient(45deg,var(--mint),var(--mint) 12px,var(--bg) 12px,var(--bg) 24px);border:1px solid var(--line);display:grid;place-items:center;text-align:center;padding:20px;color:var(--mut)}
.loc-img{display:block;width:100%;max-width:340px;border-radius:12px;border:1px solid var(--line);margin-bottom:16px}
.mapf{width:100%;height:300px;border:1px solid var(--line);border-radius:12px;background:var(--mint)}
footer{background:var(--g2);color:#fff;padding:28px 0;font-size:.9rem}
footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px}
@media(max-width:760px){
.hero .wrap,.split,form{grid-template-columns:1fr}
.menu{display:block}
.links{display:none;position:absolute;left:0;right:0;top:62px;background:var(--card);flex-direction:column;align-items:flex-start;padding:16px 20px;border-bottom:1px solid var(--line)}
.links.open{display:flex}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}

#splash{position:fixed;inset:0;z-index:100;background:var(--g2);color:#fff;display:grid;place-items:center;text-align:center;transition:opacity .7s ease,visibility .7s;cursor:pointer}
#splash{animation:out .7s 2.8s forwards}
#splash.hide{opacity:0;visibility:hidden;pointer-events:none}
@keyframes out{to{opacity:0;visibility:hidden;pointer-events:none}}
#splash svg{width:96px;height:96px;animation:pop .9s cubic-bezier(.2,.9,.3,1.2) both}
#splash .splash-logo{width:min(260px,70vw);height:auto;background:#fff;padding:20px 24px;border-radius:20px;animation:pop .9s cubic-bezier(.2,.9,.3,1.2) both}
#intro{position:fixed;inset:0;z-index:99;background:rgba(10,20,14,.72);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:12px;transition:opacity .6s ease,visibility .6s;animation:out .7s 10.8s forwards}
#intro.hide{opacity:0;visibility:hidden;pointer-events:none}
#intro .pop{position:relative;max-width:min(860px,100%);max-height:calc(100% - 70px);background:#fff;border-radius:6px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.5)}
#intro img{display:block;max-width:100%;max-height:calc(100vh - 100px);width:auto;height:auto;margin:0 auto}
#intro .x{position:absolute;top:10px;right:10px;width:34px;height:34px;aspect-ratio:auto;border-radius:50%;background:#fff;color:#1b2420;font:700 22px/1 sans-serif;border:0;cursor:pointer;z-index:2}
#intro .hp{width:min(860px,100%);overflow:auto;color:#1b2420;font-size:.95rem}
.hp-head{display:flex;align-items:center;gap:16px;flex-wrap:wrap;background:#0f6b3a;color:#fff;padding:18px 56px 18px 20px}
.hp-logo{margin:0!important;background:#fff;border-radius:10px;padding:6px 8px;width:96px!important;max-width:96px;height:auto!important}
.hp-name{font:700 1.6rem Fraunces,Georgia,serif;line-height:1.1}.hp-name small{display:block;font:400 .9rem "DM Sans",sans-serif;opacity:.85}
.hp-ban{margin-left:auto;background:#7a1631;padding:10px 16px;border-radius:8px}.hp-ban b{display:block;font:700 1.2rem Fraunces,Georgia,serif}.hp-ban span{font-size:.85rem}
.hp-cols{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;padding:22px 20px 26px}
.hp-cols h4{margin:0 0 8px;font:700 1.05rem Fraunces,Georgia,serif;color:#0f6b3a;border-bottom:2px solid #7a1631;padding-bottom:4px}
.hp-cols ul{margin:0;padding-left:18px}.hp-cols p{margin:0 0 10px}
.hp-num{font:700 1.7rem Fraunces,Georgia,serif;color:#7a1631;margin-bottom:8px}
@media(max-width:700px){.hp-cols{grid-template-columns:1fr}.hp-ban{margin-left:0}}
#splash .nm{font:700 clamp(1.8rem,6vw,2.8rem) Fraunces,Georgia,serif;margin-top:14px;animation:rise .8s .5s ease both}
#splash .sub{opacity:.8;margin-top:4px;animation:rise .8s .8s ease both}
#splash .bar{width:160px;height:3px;background:rgba(255,255,255,.25);margin:22px auto 0;border-radius:3px;overflow:hidden}
#splash .bar i{display:block;height:100%;width:100%;background:#fff;transform:translateX(-100%);animation:load 2.2s .3s ease forwards}
@keyframes pop{from{opacity:0;transform:scale(.4) rotate(-20deg)}to{opacity:1;transform:none}}
@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
@keyframes load{to{transform:none}}
@media(prefers-reduced-motion:reduce){#splash *{animation-duration:.01s!important;animation-delay:0s!important}}
</style>
</head>
<body>
<div id="splash" role="status" aria-label="Loading Ziauddin Hospital">
<div>
<img class="splash-logo" src="data:image/png;base64," alt="Ziauddin logo">
<div class="nm">Ziauddin Hospital</div>
<div class="sub">Karachi</div>
<div class="bar"><i></i></div>
</div></div>

<div id="intro" role="dialog" aria-label="Welcome">
<div class="pop hp">
<button class="x" id="xbtn" type="button" aria-label="Close">&times;</button>
<div class="hp-head"><img class="hp-logo" src="data:image/png;base64," alt="Ziauddin logo"><div class="hp-name">Ziauddin Hospital<small>Karachi</small></div><div class="hp-ban"><b>Appointments open</b><span>Consultants across all major departments</span></div></div>
<div class="hp-cols">
<div><h4>Departments</h4><ul><li>Cardiology</li><li>Pediatrics</li><li>Gynecology</li><li>Orthopedics</li><li>Dentistry</li><li>Medicine</li><li>Radiology</li><li>Emergency</li></ul></div>
<div><h4>Our campuses</h4><p><b>Clifton</b><br>Shahrah-e-Ghalib, Block 6</p><p><b>Kemari</b><br>Behind KPT Hospital</p><p><b>North Nazimabad</b><br>Allama Rasheed Turabi Rd</p><p><b>Cancer Hospital</b><br>Block B</p></div>
<div><h4>Emergency, 24 hours</h4><div class="hp-num">021-35862937</div><p>Pick a doctor and request your appointment online.</p><button class="btn" id="popbook" type="button">Book appointment</button></div>
</div></div>
<button class="btn" id="enter" type="button">Enter website</button>
</div>

<div class="top"><div class="wrap"><span>Emergency 24/7: 021-35862937</span><span>Practice website – not the official Ziauddin site</span></div></div>
<header><div class="wrap"><nav>
<a class="logo" href="#home" style="display:flex;align-items:center;gap:10px"><img src="data:image/png;base64," alt="" style="height:34px;width:auto">Ziauddin <span>Hospital</span></a>
<button class="menu" id="menu" aria-expanded="false">Menu</button>
<div class="links" id="links">
<a href="#departments">Departments</a><a href="#doctors">Doctors</a><a href="#book">Book appointment</a><a href="#contact">Contact</a>
<a class="btn" href="#book">Book now</a></div>
</nav></div></header>

<main id="home">
<div class="hero"><div class="wrap">
<div>
<h1>Ziauddin Hospital: care you can trust in Karachi.</h1>
<p>Three campuses in Clifton, Kemari and North Nazimabad, with consultants, diagnostics and 24-hour emergency care. Pick a doctor and request an appointment online.</p>
<div class="acts"><a class="btn" href="#book">Book an appointment</a><a class="btn alt" href="#doctors">Find a doctor</a></div>
</div>
<aside class="er">
<h3>Emergency, 24 hours</h3><div class="num">021-35862937</div>
<ul><li><span>Clifton</span><span>Block 6</span></li><li><span>Kemari</span><span>Behind KPT</span></li><li><span>North Nazimabad</span><span>Block B</span></li><li><span>Cancer Hospital</span><span>Block B</span></li></ul>
</aside></div></div>

<section id="departments"><div class="wrap">
<h2>Departments</h2>
<div class="grid" id="deptGrid"></div>
</div></section>

<section id="doctors" class="band"><div class="wrap">
<h2>Our doctors</h2>
<div class="tools"><input id="q" type="search" placeholder="Search by doctor name" aria-label="Search doctors"><div id="chips" class="tools" style="margin:0"></div></div>
<div class="grid" id="docGrid"></div>
<p id="none" class="err" style="display:none">No doctors match. Try another name or department.</p>
</div></section>

<section id="book"><div class="wrap" style="max-width:760px">
<h2>Book an appointment</h2>
<form id="form" novalidate>
<div><label for="name">Full name</label><input id="name" required><div class="err"></div></div>
<div><label for="phone">Mobile number</label><input id="phone" type="tel" placeholder="03XX-XXXXXXX" required><div class="err"></div></div>
<div><label for="dept">Department</label><select id="dept" required></select><div class="err"></div></div>
<div><label for="doc">Doctor</label><select id="doc"></select><div class="err"></div></div>
<div><label for="date">Preferred date</label><input id="date" type="date" required><div class="err"></div></div>
<div><label for="time">Time</label><select id="time"><option>Morning (9 am – 1 pm)</option><option>Afternoon (1 pm – 5 pm)</option><option>Evening (5 pm – 8 pm)</option></select><div class="err"></div></div>
<div class="full"><label for="note">Reason for visit (optional)</label><textarea id="note" rows="3"></textarea></div>
<div class="full"><button class="btn" type="submit">Confirm appointment</button></div>
</form>
<div class="ok" id="ok" role="status"></div>
</div></section>

<section id="contact" class="band"><div class="wrap split">
<div>
<h2>Visit or call us</h2>
<p><b>Clifton campus</b><br>4/B Shahrah-e-Ghalib, Block 6, Clifton<br>021-35862937-9</p>
<p><b>Kemari campus</b><br>Plot 33, behind KPT Hospital, Kemari<br>021-32851881</p>
<p><b>North Nazimabad campus</b><br>Allama Rasheed Turabi Rd, Wahid Colony, Karachi 74700</p>
<p>Please check the official Ziauddin website for current timings and numbers.</p>
</div>
<div>
<img class="loc-img" src="data:image/jpeg;base64," alt="Dr. Ziauddin Hospital North Nazimabad Campus location, Allama Rasheed Turabi Rd, Wahid Colony, Karachi">
<div class="tools" style="margin-top:4px">
<a class="btn" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=Ziauddin+Hospital+North+Nazimabad+Karachi">Open in Google Maps</a>
<a class="btn alt" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=Ziauddin+Hospital+Clifton+Campus+Karachi">Clifton map</a>
<a class="btn alt" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=Ziauddin+Hospital+Kemari+Campus+Karachi">Kemari map</a>
</div>
</div>
</div></section>
</main>

<footer><div class="wrap"><span>© 2026 Ziauddin Hospital – practice website (doctor names are made up)</span><button class="chip" id="theme" style="color:#fff;background:transparent;border-color:rgba(255,255,255,.5)">Toggle dark mode</button></div></footer>

<script>
const depts=[["Cardiology","Heart checkups, ECG, echo and cardiac care."],["Pediatrics","Newborn to teen care and vaccinations."],["Gynecology","Maternity, antenatal and women's health."],["Orthopedics","Bones, joints, sports injuries and physio."],["Dentistry","Checkups, root canals, braces and surgery."],["Medicine","General medicine and chronic disease care."],["Radiology","X-ray, ultrasound, CT and MRI."],["Emergency","Round-the-clock trauma and urgent care."]];
const docs=[["Dr. Ayesha Khan","Cardiology","Consultant, 14 yrs"],["Dr. Imran Siddiqui","Cardiology","Professor, 20 yrs"],["Dr. Sana Malik","Pediatrics","Consultant, 9 yrs"],["Dr. Hamza Qureshi","Pediatrics","Specialist, 6 yrs"],["Dr. Fatima Raza","Gynecology","Consultant, 12 yrs"],["Dr. Bilal Ahmed","Orthopedics","Surgeon, 15 yrs"],["Dr. Hina Farooq","Dentistry","Oral surgeon, 8 yrs"],["Dr. Zain Ali","Medicine","Consultant, 11 yrs"],["Dr. Maryam Shah","Radiology","Radiologist, 10 yrs"]];
const $=s=>document.querySelector(s);
$("#deptGrid").innerHTML=depts.map(d=>`<div class="card"><h3>${d[0]}</h3><p>${d[1]}</p></div>`).join("");
let active="All";
const names=["All",...depts.map(d=>d[0]).filter(n=>docs.some(x=>x[1]===n))];
$("#chips").innerHTML=names.map(n=>`<button class="chip${n==="All"?" on":""}" data-d="${n}">${n}</button>`).join("");
function initials(n){return n.replace("Dr. ","").split(" ").map(w=>w[0]).join("")}
function showDocs(){
 const q=$("#q").value.toLowerCase();
 const list=docs.filter(d=>(active==="All"||d[1]===active)&&d[0].toLowerCase().includes(q));
 $("#docGrid").innerHTML=list.map(d=>`<div class="card doc"><div class="av">${initials(d[0])}</div><div><b>${d[0]}</b><small>${d[1]} · ${d[2]}</small></div></div>`).join("");
 $("#none").style.display=list.length?"none":"block";
}
$("#chips").onclick=e=>{const b=e.target.closest(".chip");if(!b)return;active=b.dataset.d;document.querySelectorAll("#chips .chip").forEach(c=>c.classList.toggle("on",c===b));showDocs()};
$("#q").oninput=showDocs;showDocs();
$("#dept").innerHTML='<option value="">Select department</option>'+names.slice(1).map(n=>`<option>${n}</option>`).join("");
function fillDocs(){const d=$("#dept").value;$("#doc").innerHTML='<option value="">Any available doctor</option>'+docs.filter(x=>x[1]===d).map(x=>`<option>${x[0]}</option>`).join("")}
$("#dept").onchange=fillDocs;fillDocs();
const today=new Date().toISOString().split("T")[0];$("#date").min=today;
$("#form").onsubmit=e=>{
 e.preventDefault();let ok=true;
 const chk=(id,bad,msg)=>{const el=$("#"+id),m=el.parentNode.querySelector(".err");m.textContent=bad?msg:"";if(bad)ok=false};
 chk("name",$("#name").value.trim().length<3,"Enter your full name.");
 chk("phone",!/^(03\d{2}-?\d{7})$/.test($("#phone").value.trim()),"Enter a valid number like 0300-1234567.");
 chk("dept",!$("#dept").value,"Choose a department.");
 chk("date",!$("#date").value||$("#date").value<today,"Choose today or a later date.");
 if(!ok)return;
 const box=$("#ok");
 box.style.display="block";
 box.innerHTML=`<b>Appointment requested.</b><br>${$("#name").value}, we will call ${$("#phone").value} to confirm ${$("#dept").value}${$("#doc").value?" with "+$("#doc").value:""} on ${$("#date").value} (${$("#time").value}).`;
 box.scrollIntoView({behavior:"smooth",block:"nearest"});e.target.reset();fillDocs();
};
$("#menu").onclick=()=>{const o=$("#links").classList.toggle("open");$("#menu").setAttribute("aria-expanded",o)};
$("#links").onclick=e=>{if(e.target.tagName==="A")$("#links").classList.remove("open")};
$("#theme").onclick=()=>{const r=document.documentElement,dark=matchMedia("(prefers-color-scheme:dark)").matches;const cur=r.dataset.theme||(dark?"dark":"light");r.dataset.theme=cur==="dark"?"light":"dark"};


(function(){const sp=document.getElementById("splash");let done=false;
function close(){if(done)return;done=true;sp.classList.add("hide");setTimeout(()=>sp.remove(),800)}
sp.onclick=close;setTimeout(close,2800);})();

(function(){const it=document.getElementById("intro");if(!it)return;let d=false;
function go(){if(d)return;d=true;it.classList.add("hide");setTimeout(()=>it.remove(),800)}
document.getElementById("enter").onclick=go;document.getElementById("xbtn").onclick=go;const pb=document.getElementById("popbook");if(pb)pb.onclick=()=>{go();location.hash="#book"};setTimeout(go,10800);})();
</script>
</body>
</html>
